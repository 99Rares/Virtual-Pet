{
  "version": "2.0.0",
  "options": {
    "cwd": "${workspaceFolder}"
  },
  "presentation": {
    "reveal": "always",
    "panel": "dedicated",
    "clear": true
  },
  "tasks": [
    {
      "label": "Android: Check setup",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "doctor"
      ],
      "problemMatcher": []
    },
    {
      "label": "Android: Build debug",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "build"
      ],
      "problemMatcher": [
        {
          "owner": "kotlin-build",
          "fileLocation": "absolute",
          "severity": "error",
          "pattern": {
            "regexp": "^e: (?:file://)?(.+?):(\\d+):(\\d+):?\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "kotlin-build",
          "fileLocation": "absolute",
          "severity": "warning",
          "pattern": {
            "regexp": "^w: (?:file://)?(.+?):(\\d+):(\\d+):?\\s+(.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "message": 4
          }
        },
        {
          "owner": "android-lint",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "severity": "error",
          "pattern": {
            "regexp": "^(.+):(\\d+): Error: (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        },
        {
          "owner": "android-lint",
          "fileLocation": [
            "autoDetect",
            "${workspaceFolder}"
          ],
          "severity": "warning",
          "pattern": {
            "regexp": "^(.+):(\\d+): Warning: (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        }
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Android: Unit tests",
      "type": "process",
      "command": "bash",
