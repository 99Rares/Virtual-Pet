          "severity": "error",
          "pattern": {
            "regexp": "^(.+):(\\d+): Error: (.*)$",
            "file": 1,
            "line": 2,
            "message": 3
          }
        },
        {
          "owner": "android-lint",
          "fileLocation": [
            "autoDetect",
