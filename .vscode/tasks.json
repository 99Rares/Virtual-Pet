      "args": [
        "scripts/dev.sh",
        "logcat"
      ],
      "problemMatcher": [],
      "isBackground": true
    },
    {
      "label": "Android: Inject step counter",
      "type": "process",
      "command": "bash",
      "args": [
        "scripts/dev.sh",
        "steps",
        "${input:counter}"
      ],
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "avd",
      "type": "promptString",
      "description": "AVD name (see Android: List emulators)",
      "default": "pet37"
    },
    {
      "id": "counter",
      "type": "promptString",
      "description": "Cumulative step counter: first 10000 sets baseline, then 18200 adds 8200",
      "default": "10000"
    }
  ]
}
